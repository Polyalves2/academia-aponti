{
  "expo": {
    "name": "Forma Academia",
    "slug": "forma-academia",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ]
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "formaacademia",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.formaacademia.app"
    },
    "ios": {
      "bundleIdentifier": "com.formaacademia.app"
    },
    "extra": {
      "eas": {
        "projectId": "placeholder-project-id"
      }
    }
  }
}
